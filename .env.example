# AWS S3 設定
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-northeast-1
S3_BUCKET_NAME=your_s3_bucket_name

# AWS CloudFront CDN 設定 (不需填 https://，例如 d111111abcdef8.cloudfront.net)
CLOUDFRONT_DOMAIN=your_distribution_id.cloudfront.net

# AWS RDS MySQL 資料庫設定
DB_HOST=your-rds-endpoint.xxxxxx.ap-northeast-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=your_rds_password
DB_NAME=message_board
